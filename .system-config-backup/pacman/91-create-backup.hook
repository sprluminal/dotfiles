[Trigger]
Operation = Install
Operation = Remove
Type = Package
Target = *

[Action]
Description = Renew packages list...
When = PostTransaction
Exec = /bin/sh -c 'u="${SUDO_USER:-$(logname 2>/dev/null)}"; h="$(getent passwd "$u" 2>/dev/null | cut -d: -f6)"; [ -n "$h" ] || exit 0; pacman -Qqe | grep -v "$(pacman -Qqm)" > "$h/.system-config-backup/pkglist.txt"'

{
  "layer": "top",
  "height": 20,
  "spacing": 4,
  "margin-top": 5,
  "margin-left": 5,
  "margin-right": 5,
  "modules-left": ["custom/launcher", "sway/workspaces", "sway/window", "tray", "sway/mode"],
  "modules-center": ["clock"],
  "modules-right": [
    "network",
    "disk",
    "cpu",
    "custom/cpu_temp",
    "backlight",
    "custom/memory",
    "pulseaudio",
    "battery"
  ],

  "custom/launcher": {
    "format": "<span></span>",
    "on-click": "rofi -show drun",
    "on-click-right": "~/.bin/power-menu.sh",
    "escape": true,
    "tooltip": false
  },

  "sway/workspaces": {
    "disable-scroll": true,
    "active-only": false,
    "all-outputs": true,
    "warp-on-scroll": false,
    "format": "{icon}",
    "format-icons": {
      "1": "<span>󰧨</span>",
      "2": "<span>󰈹</span>",
      "3": "<span></span>",
      "4": "<span></span>",
      "5": "<span></span>",
      "6": "<span>󰭛</span>",
      "7": "<span>󱓷</span>",
      "8": "<span>󰴘</span>",
      "9": "<span>󰟝</span>",
      "10": "<span>󰚀</span>"
    }
  },

  "sway/window": {
    "format": "<span color='#1d2021' bgcolor='#d3869b'> 󰣆 </span> {app_id}",
    "separate-outputs": true,
    "tooltip": false
  },

  "sway/mode": {
    "format": " {}",
    "max-length": 50
  },

  "tray": {
    "icon-size": 14,
    "spacing": 8
  },

  "disk": {
    "format": "<span color='#1d2021' bgcolor='#8ec07c'>  </span> {free}",
    "interval": 20
  },

  "cpu": {
    "format": "<span color='#1d2021' bgcolor='#fe8019'>  </span> {usage}%",
    "tooltip": false,
    "interval": 1,
    "on-click": "kitty --class=floating_waybar -e btop"
  },

  "custom/cpu_temp": {
    "exec": "~/.config/waybar/scripts/waybarTemp.sh",
    "return-type": "json",
    "interval": 2,
    "format": "{}",
    "tooltip": false
  },

  "backlight": {
    "format": "<span color='#1d2021' bgcolor='#fabd2f'> 󰞏 </span> {percent}%",
    "tooltip": false,
    "on-click-right": "~/.bin/wlsunset-toggle.sh"
  },

  "custom/memory": {
    "exec": "~/.config/waybar/scripts/memory_usage.sh",
    "interval": 2,
    "return-type": "json",
    "format": "<span color='#1d2021' bgcolor='#458588'>  </span> {}"
  },

  "pulseaudio": {
    "scroll-step": 1,
    "format": "<span color='#1d2021' bgcolor='#83a598'>  </span> {volume}%",
    "format-muted": "<span color='#1d2021' bgcolor='#cc241d'>  </span> {volume}%",
    "format-bluetooth": "<span color='#1d2021' bgcolor='#83a598'> 󰂰 </span> {volume}%",
    "format-bluetooth-muted": "<span color='#1d2021' bgcolor='#cc241d'> 󰂲 </span> {volume}%",
    "format-source": "{volume}% ",
    "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "on-click-right": "kitty --class=floating_waybar -e pulsemixer",
    "tooltip": false,
    "max-volume": 130
  },

  "battery#bat2": {
    "bat": "BAT2"
  },

  "battery": {
    "interval": 1,
    "states": {
      "good": 99,
      "warning": 30,
      "critical": 20
    },
    "format-icons": ["󰂎", "󰁺", "󰁻", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    "format": "<span color='#1d2021' bgcolor='#689d6a'> {icon} </span> {capacity}%",
    "format-critical": "<span color='#1d2021' bgcolor='#fb4934'> {icon} </span> {capacity}%!!",
    "format-warning": "<span color='#1d2021' bgcolor='#fe8019'> {icon} </span> {capacity}%",
    "format-full": "<span color='#1d2021' bgcolor='#689d6a'> {icon} </span> {capacity}%",
    "format-charging": "<span color='#1d2021' bgcolor='#689d6a'> 󰂅 </span> {capacity}%",
    "format-charging-warning": "<span color='#1d2021' bgcolor='#fe8019'> 󰢝 </span> {capacity}%",
    "format-charging-critical": "<span color='#1d2021' bgcolor='#fb4934'> 󰢜 </span> {capacity}%",
    "format-plugged": "<span color='#1d2021' bgcolor='#689d6a'> 󰂅 </span> {capacity}%",
    "format-alt": "<span color='#1d2021' bgcolor='#689d6a'> 󱧥 </span> {time}",
    "tooltip": false
  },

  "network": {
    "interval": 2,
    "format": "<span color='#1d2021' bgcolor='#d3869b'> 󱘖 </span> {bandwidthDownBits}",
    "format-wifi": "<span color='#1d2021' bgcolor='#d3869b'> {icon} </span> {bandwidthDownBits}",
    "format-ethernet": "<span color='#1d2021' bgcolor='#d3869b'> 󰈀 </span> {bandwidthDownBits}",
    "format-disconnected": "<span color='#1d2021' bgcolor='#cc241d'> ⚠ </span> disconnected",
    "format-icons": ["󰤫", "󰤟", "󰤢", "󰤥", "󰤨"],
    "tooltip": true,
    "tooltip-format": "{essid}\n{ipaddr}/{cidr}",
    "on-click": "kitty --class=floating_waybar -e nmtui",
    "states": {
      "normal": 25
    }
  },

  "clock": {
    "format": "<span color='#1d2021' bgcolor='#8ec07c'>  </span> {:%a %d | %H:%M}",
    "format-alt": "<span color='#1d2021' bgcolor='#8ec07c'>  </span> {:%A, %d %b, %Y}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "weeks-pos": "left",
      "on-scroll": 1,
      "format": {
        "months": "<span color='#ebdbb2'><b>{}</b></span>",
        "days": "<span color='#ebdbb2'><b>{}</b></span>",
        "weeks": "<span color='#b8bb26'><b>W{}</b></span>",
        "weekdays": "<span color='#d79921'><b>{}</b></span>",
        "today": "<span color='#fe8019'><b><u>{}</u></b></span>"
      }
    },
    "actions": {
      "on-click-right": "mode",
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down"
    }
  }
}

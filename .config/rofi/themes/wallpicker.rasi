@import "~/.config/rofi/themes/colors.rasi"

* {
  margin : 0;
  padding : 0;
  spacing : 0;
  highlight : underline bold @red;
  font : "my-queue ExtraBold 14";
}

configuration {
  display-drun : "APPS";
  display-run : "CMD";
  display-window : "WIN";
}

window {
  width : 75%;
  border : 3;
  margin: 0;
  border-color : @yellow-bright;
  background-color : @bg0;
  location : center;
  orientaion : horizontal;
  children : [inputbar, message, listview];
}

inputbar {
  background-color : @bg0;
  children : [prompt,entry];
}

prompt {
  margin : 6 0 6 6;
  padding : 3 6;
  text-color : @bg0-hard;
  border : 3;
  border-color : @red-bright;
  background-color : @red-bright;
}

entry {
  margin : 6;
  padding : 3 6;
  text-color : @red-bright;
  border : 3;
  border-color : @yellow-bright;
  background-color : @bg0;
}

listview {
  lines : 3;
  columns : 6;
  children : [element];
  margin : 0 6 6 6;
  padding : 6 6 0 6;
  border : 3;
  border-color : @yellow-bright;
  background-color : @bg0;
}

element {
  margin : 0 0 6 0;
  background-color : @bg0;

  orientation : vertical;
  children : [element-icon, element-text];
}

element selected active {
  text-color : @fg1;
  background-color : @red;
}

element-text {
  expand : false;

  horizontal-align : 0.5;
  vertical-align : 1.0;

  padding : 6 12;
  margin : 6;

  text-color : @bg0-hard;
  background-color : @yellow-bright;
  font : "my-queue ExtraBold 10";
}


element-text selected {
  text-color : @bg0-hard;
  background-color : @red-bright;
}

element-text selected active {
  text-color : @fg1;
  background-color : @red;
}

element-icon{
  size : 200;
  border : 3;
  border-color: @yellow-bright;
  margin : 6;
  padding : 2;
  background-color : @bg0;
}

element-icon selected {
  text-color : @yellow-bright;
  border-color: @red-bright;
  background-color : @bg0;
}

element-icon selected active {
  text-color : @fg1;
  background-color : @red;
}

message {
  margin : 0;
  expand : true;
  background-color : @bg0;
  children : [textbox];
}

textbox {
  expand : true;
  padding : 6;
  border-color : @red;
  background-color : @bg0;
  text-color : @red;
}

error-message {
  expand : true;
  text-color : @bg0-hard;
}

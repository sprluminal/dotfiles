@import "~/.config/rofi/themes/colors.rasi"

* {
  margin : 0;
  padding : 0;
  spacing : 0;
  highlight : underline bold @red;
  font : "my-queue ExtraBold 14";
}

configuration {
  display-drun : "APPS";
  display-run : "CMD";
  display-window : "WIN";
}

window {
  width : 25%;
  border : 3;
  border-color : @yellow-bright;
  background-color : @bg0;
  location : center;
  orientaion : horizontal;
  children : [inputbar, message, listview];
}

inputbar {
  background-color : @bg0;
  children : [prompt,entry];
}

prompt {
  margin : 6 0 6 6;
  padding : 3 6;
  text-color : @bg0-hard;
  border : 3;
  border-color : @red-bright;
  background-color : @red-bright;
}

entry {
  margin : 6;
  padding : 3 6;
  text-color : @red-bright;
  border : 3;
  border-color : @yellow-bright;
  background-color : @bg0;
}

listview {
  lines : 8;
  children : [element];
  margin : 0 6 6 6;
  padding : 6 6 0 6;
  border : 3;
  border-color : @yellow-bright;
  background-color : @bg0;
}

element {
  margin : 0 0 6 0 ;
  background-color : @bg0;
}

element selected active {
  text-color : @fg1;
  background-color : @red;
}

element-text {
  padding : 6;
  text-color : @fg1;
  background-color : @bg0;
}

element-text selected {
  text-color : @bg0-hard;
  background-color : @yellow-bright;
}

element-text selected active {
  text-color : @fg1;
  background-color : @red;
}

element-icon{
  size : 20;
  padding : 6;
  background-color : @bg0;
}

element-icon selected {
  text-color : @bg0-hard;
  background-color : @yellow-bright;
}

element-icon selected active {
  text-color : @fg1;
  background-color : @red;
}

message {
  margin : 0;
  expand : true;
  background-color : @bg0;
  children : [textbox];
}

textbox {
  expand : true;
  padding : 6;
  border-color : @red;
  background-color : @bg0;
  text-color : @red;
}

error-message {
  expand : true;
  text-color : @bg0-hard;
}
